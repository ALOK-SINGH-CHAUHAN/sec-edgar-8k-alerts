# SEC User-Agent Override (Optional: overrides user_agent in config.yaml)
# Format: AppName/Version (name@domain.com)
SEC_USER_AGENT=EdgarAlertsBot/1.0 (trader.alert@domain.com)

# Telegram Bot Credentials
# Obtain token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Obtain chat_id by messaging your bot and querying:
# https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# Optional SMTP Email Configuration
SMTP_PASSWORD=your_smtp_app_password
